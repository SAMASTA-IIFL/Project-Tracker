VITE_API_URL="http://localhost:8000"

# Firebase web config — public identifiers, not secrets. Firebase Console >
# Project Settings > General > "Your apps" > the web app's config object.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# This file is the LOCAL-DEV copy only. `frontend/.env` is gitignored and never
# committed. CI does not read it: .github/workflows/frontend-build.yml injects
# the same six VITE_FIREBASE_* names from GitHub repository secrets at build
# time (Settings > Secrets and variables > Actions), and docker/docker-compose.yml
# passes them through as build args for a local image build.
