# Firestore + Firebase Authentication (Google Sign-In). Create a Firebase
# project (or reuse one), enable Firestore and the Google sign-in provider
# under Authentication > Sign-in method, then generate a service-account key:
# Project Settings > Service Accounts > "Generate new private key". Save the
# JSON file somewhere outside git and point this at it.
FIREBASE_CREDENTIALS_PATH="./firebase-service-account.json"
# Usually inferred from the service account file above — only set this if
# that inference doesn't work for some reason.
# FIREBASE_PROJECT_ID=

# Comma-separated emails auto-promoted to Admin the first time they sign in
# with Google — there's no in-app "make someone Admin" flow yet, so this is
# how the first admin(s) get seeded.
FIREBASE_ADMIN_EMAILS="you@company.com"

# Secrets Vault admin breakglass — a genuine server-held secret. If unset,
# breakglass stays disabled (no recovery keypair is generated) rather than
# the app failing to start.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_RECOVERY_MASTER_KEY=

# AI provider — "mock" needs no API key and gives deterministic output for dev/demo.
# Swap to "anthropic" | "gemini" | "openai" | "azure-openai" later via this var only
# ("openai"/"azure-openai" aren't implemented yet — see app/ai.py).
AI_PROVIDER="mock"
# AI_MODEL=            # optional: override the provider's default model
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Storage — "local-disk" needs no cloud credentials. Swap to "s3" later via this var only.
STORAGE_PROVIDER="local-disk"
STORAGE_LOCAL_DIR="./.uploads"
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
