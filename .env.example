# Database — hosted on Supabase (just Postgres; nothing else about the app
# depends on Supabase). Get this from your Supabase project: Project Settings
# > Database > Connection string > URI. Use the "Session pooler" or direct
# connection string, NOT the "Transaction pooler" (port 6543) — FastAPI is a
# long-running process, and the transaction pooler's lack of prepared-statement
# support breaks SQLAlchemy. Keep sslmode=require.
DATABASE_URL="postgresql+psycopg://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres?sslmode=require"

# If you'd rather run Postgres locally instead of Supabase (e.g. offline dev),
# this also works — just swap the line above for:
# DATABASE_URL="postgresql+psycopg://product_pro:product_pro@localhost:5432/product_pro"

# Auth
# dev-credentials: email+password checked against AUTH_USERS in .env.users
# (see .env.users.example) — no external SSO app registration needed.
# Swap to "entra-id" or "google" later once real SSO app credentials are available.
AUTH_PROVIDER="dev-credentials"
JWT_SECRET="dev-secret-change-me"
# AUTH_ENTRA_ID_ID=
# AUTH_ENTRA_ID_SECRET=
# AUTH_ENTRA_ID_TENANT_ID=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Secrets Vault admin breakglass — a genuine server-held secret, treat like
# JWT_SECRET. If unset, breakglass stays disabled (no recovery keypair is
# generated) rather than the app failing to start.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_RECOVERY_MASTER_KEY=

# AI provider — "mock" needs no API key and gives deterministic output for dev/demo.
# Swap to "anthropic" | "gemini" | "openai" | "azure-openai" later via this var only
# ("openai"/"azure-openai" aren't implemented yet — see app/ai.py).
AI_PROVIDER="mock"
# AI_MODEL=            # optional: override the provider's default model
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Storage — "local-disk" needs no cloud credentials. Swap to "s3" later via this var only.
STORAGE_PROVIDER="local-disk"
STORAGE_LOCAL_DIR="./.uploads"
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
